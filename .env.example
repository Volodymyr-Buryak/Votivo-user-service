# Export these variables in your shell/IDE; Spring Boot does not load .env automatically.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/user_db
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=user
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=15675
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_VIRTUAL_HOST=/
APP_IDENTITY_BASE_URL=http://localhost:18080
APP_IDENTITY_REALM=votivo
APP_IDENTITY_CLIENT_ID=user-service-sync
# Same value as KEYCLOAK_USER_SERVICE_SYNC_SECRET used to configure Keycloak.
APP_IDENTITY_CLIENT_SECRET=replace_with_a_unique_random_secret
APP_IDENTITY_SYNC_ENABLED=true
APP_IDENTITY_PAGE_SIZE=100
APP_IDENTITY_RECONCILE_INTERVAL=PT1H
APP_IDENTITY_MANAGEMENT_CLIENT_ID=user-service-management
APP_IDENTITY_MANAGEMENT_CLIENT_SECRET=replace_with_a_unique_management_secret
APP_IDENTITY_MANAGEMENT_EMAIL_AS_USERNAME=true
APP_SECURITY_ISSUER_URI=http://localhost:18080/realms/votivo
APP_SECURITY_JWK_SET_URI=http://localhost:18080/realms/votivo/protocol/openid-connect/certs
APP_SECURITY_AUDIENCE=user-service
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:4200
